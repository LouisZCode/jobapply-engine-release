<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template — generated by `setup/setup.sh --schedule HH:MM` into setup/generated/
     (gitignored), substituting {{label_prefix}} (a reverse-DNS-style namespace unique to
     this install, e.g. com.<username>), {{install_path}} (this repo's absolute path on the
     target machine), {{run_hour}}/{{run_minute}} (the daily local run time you chose),
     {{label_suffix}} ("-<user>" for a per-user schedule, MULTI-002b) and the env-block
     placeholder on its own line (the per-user EnvironmentVariables block; removed for
     the old single-user schedule).
     setup.sh never installs or loads this file itself — it prints the `cp` +
     `launchctl load` commands for you to run by hand after reviewing the rendered plist. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{label_prefix}}.jobapply{{label_suffix}}</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{install_path}}/claude_applicator/run_scheduled.sh</string>
  </array>
  {{env_block}}

  <!-- Fires once daily at the local time you chose during setup. The routine self-gates
       on MODE / daily cap / run window (read fresh from run_config.txt on every run), so a
       fixed launchd cadence is safe — it will simply no-op outside the configured window
       or once the cap is reached. If this Mac tends to be asleep at the chosen time, pair
       this with a pre-wake (setup.sh --schedule prints the exact
       `sudo pmset repeat wakeorpoweron` command; verify anytime with `pmset -g sched`). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>{{run_hour}}</integer>
    <key>Minute</key><integer>{{run_minute}}</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>{{install_path}}/claude_applicator/output/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>{{install_path}}/claude_applicator/output/launchd.err.log</string>
</dict>
</plist>
