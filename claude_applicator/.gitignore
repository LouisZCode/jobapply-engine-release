# PII / secrets (profile.yaml, qa_bank.md and data/ are also ignored, unanchored, by the
# repo-root .gitignore — repeated here for clarity/defense-in-depth)
profile.yaml
qa_bank.md
data/
*.session

# Generated at setup by setup/render_templates.py (rendered from the tracked
# *.template.md source + profile.yaml, or written directly) — never track the live
# copies; only the *.template.* sources are tracked.
CLAUDE.md
writer/WRITER.md
inbox_reader/MAIL_AGENT.md
user.env
inbox_reader/user_mail.json

# SQLite state
*.db
*.db-journal
*.db-wal
*.db-shm
*.db.bak*

# Run artifacts
output/
*.log
*.png
